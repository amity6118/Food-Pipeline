# Environment Configuration for Food Order ETL Pipeline
# Copy this file to .env and replace every "change_me" value before running
# `docker compose up`. The .env file is git-ignored; never commit real secrets.
# Passwords must not contain single quotes (they are embedded in SQL at init).

# ==========================================
# MySQL Database Configuration
# ==========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=etl_user
MYSQL_PASSWORD=change_me_etl

# Power BI Dedicated Read-Only User
POWERBI_USER=powerbi_reader
POWERBI_PASSWORD=change_me_powerbi

# Database Names
STAGING_DB=food_staging
CONTROL_DB=food_control
DW_DB=food_dw

# External Access (From Windows Host / Power BI Desktop)
HOST_MYSQL_PORT=3306
HOST_ADMINER_PORT=8080
HOST_MOCK_API_PORT=8000

# ==========================================
# Pipeline Orchestration & Scheduler
# ==========================================
# Cron schedule format: minute hour day month day-of-week
# Default: Runs every day at 02:00 in PIPELINE_TIMEZONE
PIPELINE_CRON_SCHEDULE=0 2 * * *
PIPELINE_TIMEZONE=Asia/Kolkata
PIPELINE_ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# Data Paths (Container paths)
# ==========================================
DATA_LANDING_DIR=/app/data/landing
DATA_ARCHIVE_DIR=/app/data/archive
DATA_ERROR_DIR=/app/data/error
LOG_DIR=/app/logs

# ==========================================
# Mock API Settings
# ==========================================
MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=8000
MOCK_API_BASE_URL=http://mock_api:8000

# ==========================================
# Notifications & Alerting (Pluggable)
# ==========================================
ALERT_CHANNEL=console
# Optional Webhook URL (Slack, Discord, MS Teams webhook)
ALERT_WEBHOOK_URL=
# Optional SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@foodorderpipeline.local
ALERT_EMAIL_TO=admin@foodorderpipeline.local
