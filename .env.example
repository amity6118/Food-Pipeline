# Environment configuration for the Food Order ETL Pipeline.
# Copy this file to .env and replace every "change_me" value before running
# `docker compose up`. The .env file is git-ignored; never commit real secrets.
# Passwords must not contain single quotes (they are embedded in SQL at init).

# ==========================================
# MySQL credentials
# ==========================================
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=etl_user
MYSQL_PASSWORD=change_me_etl

# Power BI dedicated read-only user
POWERBI_USER=powerbi_reader
POWERBI_PASSWORD=change_me_powerbi

# ==========================================
# Connection settings for running Python on the Windows host
# (the etl container overrides these with container-network addresses).
# If you change HOST_MYSQL_PORT below, set MYSQL_PORT to the same value.
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MOCK_API_BASE_URL=http://localhost:8000

# Database names (must match the scripts in sql/init)
STAGING_DB=food_staging
CONTROL_DB=food_control
DW_DB=food_dw

# ==========================================
# Ports published on the Windows host
# ==========================================
HOST_MYSQL_PORT=3306
HOST_ADMINER_PORT=8080
HOST_MOCK_API_PORT=8000

# ==========================================
# Pipeline scheduling & logging
# ==========================================
# Cron format: minute hour day month day-of-week (default: daily at 02:00)
PIPELINE_CRON_SCHEDULE=0 2 * * *
PIPELINE_TIMEZONE=Asia/Kolkata
# Also run once as soon as the scheduler starts (handy for demos)
RUN_ON_STARTUP=false
LOG_LEVEL=INFO

# ==========================================
# Failure notifications: comma-separated list of console, webhook, email
# (console is always on)
# ==========================================
ALERT_CHANNEL=console
# Slack / Discord / MS Teams incoming-webhook URL
ALERT_WEBHOOK_URL=
# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@foodorderpipeline.local
ALERT_EMAIL_TO=admin@foodorderpipeline.local
