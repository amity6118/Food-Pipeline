            "formatString": "yyyy-mm-dd hh:nn:ss"
          }
        ],
        "partitions": [
          {
            "name": "dq_results",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(MySQLServer, ControlDatabase, [ReturnSingleDatabase = true]),",
                "    Data = Source{[Schema = ControlDatabase, Item = \"dq_results\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"result_id\", \"batch_id\", \"rule_name\", \"stage\", \"severity\", \"violation_count\", \"outcome\", \"executed_at\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "DQ Warnings",
            "expression": "CALCULATE ( COUNTROWS ( dq_results ), dq_results[outcome] = \"WARN\" )",
            "formatString": "#,0"
          },
          {
            "name": "DQ Failures",
            "expression": "CALCULATE ( COUNTROWS ( dq_results ), dq_results[outcome] = \"FAIL\" )",
            "formatString": "#,0"
          },
          {
            "name": "Violations",
            "expression": "SUM ( dq_results[violation_count] )",
            "formatString": "#,0"
          }
        ]
      },
