      },
      {
        "name": "etl_job_log",
        "columns": [
          {
            "name": "job_id",
            "dataType": "int64",
            "sourceColumn": "job_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "job_name",
            "dataType": "string",
            "sourceColumn": "job_name",
            "summarizeBy": "none"
          },
          {
            "name": "batch_id",
            "dataType": "string",
            "sourceColumn": "batch_id",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "start_time",
            "dataType": "dateTime",
            "sourceColumn": "start_time",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn:ss"
          },
          {
            "name": "end_time",
            "dataType": "dateTime",
            "sourceColumn": "end_time",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn:ss"
          },
          {
            "name": "duration_seconds",
            "dataType": "int64",
            "sourceColumn": "duration_seconds",
            "summarizeBy": "sum"
          },
          {
            "name": "rows_read",
            "dataType": "int64",
            "sourceColumn": "rows_read",
            "summarizeBy": "sum"
          },
          {
            "name": "rows_inserted",
            "dataType": "int64",
            "sourceColumn": "rows_inserted",
            "summarizeBy": "sum"
          },
          {
            "name": "rows_updated",
            "dataType": "int64",
            "sourceColumn": "rows_updated",
            "summarizeBy": "sum"
          },
          {
            "name": "rows_rejected",
            "dataType": "int64",
            "sourceColumn": "rows_rejected",
            "summarizeBy": "sum"
          },
          {
            "name": "error_message",
            "dataType": "string",
            "sourceColumn": "error_message",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "etl_job_log",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(MySQLServer, ControlDatabase, [ReturnSingleDatabase = true]),",
                "    Data = Source{[Schema = ControlDatabase, Item = \"etl_job_log\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"job_id\", \"job_name\", \"batch_id\", \"status\", \"start_time\", \"end_time\", \"duration_seconds\", \"rows_read\", \"rows_inserted\", \"rows_updated\", \"rows_rejected\", \"error_message\"})",
                "in",
                "    Selected"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Pipeline Runs",
            "expression": "CALCULATE ( COUNTROWS ( etl_job_log ), etl_job_log[job_name] = \"pipeline_run\" )",
            "formatString": "#,0"
          },
          {
            "name": "Failed Runs",
            "expression": "CALCULATE ( [Pipeline Runs], etl_job_log[status] = \"FAILED\" )",
            "formatString": "#,0"
          },
          {
            "name": "Run Success Rate",
            "expression": "DIVIDE ( [Pipeline Runs] - [Failed Runs], [Pipeline Runs] )",
            "formatString": "0.0%"
          },
          {
            "name": "Rows Loaded",
            "expression": "CALCULATE ( SUM ( etl_job_log[rows_inserted] ), LEFT ( etl_job_log[job_name], 7 ) = \"sp_load\" )",
            "formatString": "#,0"
          },
          {
            "name": "Rows Rejected",
            "expression": "CALCULATE ( SUM ( etl_job_log[rows_rejected] ), LEFT ( etl_job_log[job_name], 7 ) = \"sp_load\" )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Run Seconds",
            "expression": "CALCULATE ( AVERAGE ( etl_job_log[duration_seconds] ), etl_job_log[job_name] = \"pipeline_run\" )",
            "formatString": "0.0"
          }
        ]
      },
