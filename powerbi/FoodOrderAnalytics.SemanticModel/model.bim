{
  "name": "FoodOrderAnalytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-IN",
    "tables": [
      {
        "name": "fact_orders",
        "columns": [
          {
            "name": "order_key",
            "dataType": "int64",
            "sourceColumn": "order_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_key",
            "dataType": "int64",
            "sourceColumn": "customer_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "restaurant_key",
            "dataType": "int64",
            "sourceColumn": "restaurant_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "delivery_partner_key",
            "dataType": "int64",
            "sourceColumn": "delivery_partner_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "payment_method_key",
            "dataType": "int64",
            "sourceColumn": "payment_method_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_datetime",
            "dataType": "dateTime",
            "sourceColumn": "order_datetime",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "gross_amount",
            "dataType": "decimal",
            "sourceColumn": "gross_amount",
            "summarizeBy": "sum",
            "formatString": "\\₹#,0.00"
          },
          {
            "name": "discount",
            "dataType": "decimal",
            "sourceColumn": "discount",
            "summarizeBy": "sum",
            "formatString": "\\₹#,0.00"
          },
          {
            "name": "delivery_fee",
            "dataType": "decimal",
            "sourceColumn": "delivery_fee",
            "summarizeBy": "sum",
            "formatString": "\\₹#,0.00"
          },
          {
            "name": "net_amount",
            "dataType": "decimal",
            "sourceColumn": "net_amount",
            "summarizeBy": "sum",
            "formatString": "\\₹#,0.00"
          },
          {
            "name": "delivery_minutes",
            "dataType": "int64",
            "sourceColumn": "delivery_minutes",
            "summarizeBy": "average"
          },
          {
            "name": "is_late",
            "dataType": "int64",
            "sourceColumn": "is_late",
            "summarizeBy": "none"
          },
          {
            "name": "rating",
            "dataType": "double",
            "sourceColumn": "rating",
            "summarizeBy": "average"
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "batch_id",
            "dataType": "string",
            "sourceColumn": "batch_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_hour",
            "dataType": "int64",
            "sourceColumn": "order_hour",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(MySQLServer, WarehouseDatabase, [ReturnSingleDatabase = true]),",
                "    Data = Source{[Schema = WarehouseDatabase, Item = \"fact_orders\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"order_key\", \"order_id\", \"date_key\", \"customer_key\", \"restaurant_key\", \"delivery_partner_key\", \"payment_method_key\", \"order_datetime\", \"gross_amount\", \"discount\", \"delivery_fee\", \"net_amount\", \"delivery_minutes\", \"is_late\", \"rating\", \"order_status\", \"batch_id\"}),",
                "    Flags = Table.TransformColumns(Selected, {{\"is_late\", Number.From, Int64.Type}}),",
                "    Typed = Table.TransformColumnTypes(Flags, {{\"gross_amount\", Currency.Type}, {\"discount\", Currency.Type}, {\"delivery_fee\", Currency.Type}, {\"net_amount\", Currency.Type}, {\"rating\", type number}}),",
                "    Added_order_hour = Table.AddColumn(Typed, \"order_hour\", each Time.Hour([order_datetime]), Int64.Type)",
                "in",
                "    Added_order_hour"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Orders",
            "expression": "COUNTROWS ( fact_orders )",
            "formatString": "#,0"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE ( [Total Orders], fact_orders[order_status] = \"DELIVERED\" )",
            "formatString": "#,0"
          },
          {
            "name": "GMV",
            "expression": "CALCULATE ( SUM ( fact_orders[gross_amount] ), fact_orders[order_status] = \"DELIVERED\" )",
            "formatString": "\\₹#,0"
          },
          {
            "name": "Net Revenue",
            "expression": "CALCULATE ( SUM ( fact_orders[net_amount] ), fact_orders[order_status] = \"DELIVERED\" )",
            "formatString": "\\₹#,0"
          },
          {
            "name": "AOV",
            "expression": "DIVIDE ( [GMV], [Delivered Orders] )",
            "formatString": "\\₹#,0.00"
          },
          {
            "name": "Cancellation Rate",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Total Orders], fact_orders[order_status] = \"CANCELLED\" ),",
              "    [Total Orders]",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "On-Time %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Delivered Orders], fact_orders[is_late] = 0 ),",
              "    [Delivered Orders]",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Avg Rating",
            "expression": "AVERAGE ( fact_orders[rating] )   -- blanks (unrated orders) are ignored",
            "formatString": "0.00"
          },
          {
            "name": "Repeat Customer %",
            "expression": [
              "VAR CustomerOrders =",
              "    ADDCOLUMNS (",
              "        VALUES ( dim_customer[customer_id] ),     -- natural key, so SCD2 versions count once",
              "        \"@orders\", CALCULATE ( COUNTROWS ( fact_orders ) )",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS ( FILTER ( CustomerOrders, [@orders] > 1 ) ),",
              "        COUNTROWS ( FILTER ( CustomerOrders, [@orders] > 0 ) )",
              "    )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Avg Delivery Minutes",
            "expression": "AVERAGE ( fact_orders[delivery_minutes] )",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "fact_order_items",
