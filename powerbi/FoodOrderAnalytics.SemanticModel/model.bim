            "dataType": "string",
            "sourceColumn": "payment_method_id",
            "summarizeBy": "none"
          },
          {
            "name": "method_name",
            "dataType": "string",
            "sourceColumn": "method_name",
            "summarizeBy": "none"
          },
          {
            "name": "method_category",
            "dataType": "string",
            "sourceColumn": "method_category",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_payment_method",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(MySQLServer, WarehouseDatabase, [ReturnSingleDatabase = true]),",
                "    Data = Source{[Schema = WarehouseDatabase, Item = \"dim_payment_method\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"payment_method_key\", \"payment_method_id\", \"method_name\", \"method_category\"})",
                "in",
