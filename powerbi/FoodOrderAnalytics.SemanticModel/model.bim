          {
            "name": "line_total",
            "dataType": "decimal",
            "sourceColumn": "line_total",
            "summarizeBy": "sum",
            "formatString": "\\₹#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "fact_order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(MySQLServer, WarehouseDatabase, [ReturnSingleDatabase = true]),",
                "    Data = Source{[Schema = WarehouseDatabase, Item = \"fact_order_items\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"order_item_key\", \"order_key\", \"menu_item_key\", \"quantity\", \"unit_price\", \"line_total\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"unit_price\", Currency.Type}, {\"line_total\", Currency.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Items Sold",
            "expression": "SUM ( fact_order_items[quantity] )",
            "formatString": "#,0"
          }
        ]
      },
