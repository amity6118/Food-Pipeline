# Auto detect text files and perform LF normalization
* text=auto

# Explicit LF line endings for container execution & bash scripts
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.env* text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf

# Diagrams
*.svg text eol=lf
*.png binary
